<?xml version="1.0" ?>
<robot name="hunter">

  <!-- ===== Base and Chassis ===== -->
  <link name="base_link"/>
  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
    <origin rpy="0 0 0" xyz="0 0 0.37"/>
  </joint>

  <link name="chassis">
    <visual>
      <geometry>
        <mesh filename="package://hunter_model/meshes/chassis.dae"/>
      </geometry>
      <material name="body_gray">
        <color rgba="0.6 0.6 0.6 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://hunter_model/meshes/chassis.dae"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="80"/>
      <inertia ixx="2.0" ixy="0" ixz="0" iyy="2.0" iyz="0" izz="2.0"/>
    </inertial>
  </link>

  <!-- ===== Rear Wheels ===== -->
  <link name="rear_left_wheel">
    <visual>
      <geometry>
        <mesh filename="package://hunter_model/meshes/rear_left_wheel.dae"/>
      </geometry>
      <material name="black_wheel">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://hunter_model/meshes/rear_left_wheel.dae"/>
      </geometry>
    </collision>
    <inertial><mass value="7"/><inertia ixx="0.06" iyy="0.06" izz="0.11"/></inertial>
  </link>

  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="chassis"/>
    <child link="rear_left_wheel"/>
    <origin rpy="1.5708 0 0" xyz="-0.28 0.2925 -0.19558"/>
    <axis xyz="0 0 -1"/>
    <dynamics damping="0.1" friction="2.0"/>
    <limit effort="50.0" velocity="50.0"/>
  </joint>

  <link name="rear_right_wheel">
    <visual>
      <geometry>
        <mesh filename="package://hunter_model/meshes/rear_right_wheel.dae"/>
      </geometry>
      <material name="black_wheel">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://hunter_model/meshes/rear_right_wheel.dae"/>
      </geometry>
    </collision>
    <inertial><mass value="7"/><inertia ixx="0.06" iyy="0.06" izz="0.11"/></inertial>
  </link>

  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="chassis"/>
    <child link="rear_right_wheel"/>
    <origin rpy="1.5708 0 0" xyz="-0.28 -0.2925 -0.19558"/>
    <axis xyz="0 0 -1"/>
    <dynamics damping="0.1" friction="2.0"/>
    <limit effort="50.0" velocity="50.0"/>
  </joint>

  <!-- ===== Front Steering + Wheels ===== -->
  <link name="front_left_steering_link">
    <inertial><mass value="0.01"/><inertia ixx="0.01" iyy="0.01" izz="0.01"/></inertial>
  </link>

  <joint name="front_left_steering_joint" type="continuous">
    <parent link="chassis"/>
    <child link="front_left_steering_link"/>
    <origin rpy="1.5708 0 0" xyz="0.37142 0.2925 -0.19558"/>
    <axis xyz="0 1 0"/>
    <limit effort="20.0" velocity="5.0"/>
    <dynamics damping="0.1" friction="0.2"/>
  </joint>

  <link name="front_left_wheel">
    <visual>
      <geometry>
        <mesh filename="package://hunter_model/meshes/front_left_wheel.dae"/>
      </geometry>
      <material name="black_wheel">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://hunter_model/meshes/front_left_wheel.dae"/>
      </geometry>
    </collision>
    <inertial><mass value="7"/><inertia ixx="0.06" iyy="0.06" izz="0.11"/></inertial>
  </link>

  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="front_left_steering_link"/>
    <child link="front_left_wheel"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit effort="50.0" velocity="50.0"/>
  </joint>

  <link name="front_right_steering_link">
    <inertial><mass value="0.01"/><inertia ixx="0.01" iyy="0.01" izz="0.01"/></inertial>
  </link>

  <joint name="front_right_steering_joint" type="continuous">
    <parent link="chassis"/>
    <child link="front_right_steering_link"/>
    <origin rpy="1.5708 0 0" xyz="0.37142 -0.2925 -0.19558"/>
    <axis xyz="0 1 0"/>
    <limit effort="20.0" velocity="5.0"/>
    <dynamics damping="0.1" friction="0.2"/>
  </joint>

  <link name="front_right_wheel">
    <visual>
      <geometry>
        <mesh filename="package://hunter_model/meshes/front_right_wheel.dae"/>
      </geometry>
      <material name="black_wheel">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://hunter_model/meshes/front_right_wheel.dae"/>
      </geometry>
    </collision>
    <inertial><mass value="7"/><inertia ixx="0.06" iyy="0.06" izz="0.11"/></inertial>
  </link>

  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="front_right_steering_link"/>
    <child link="front_right_wheel"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit effort="50.0" velocity="50.0"/>
  </joint>

</robot>
