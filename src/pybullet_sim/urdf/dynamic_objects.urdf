<robot name="dynamic_objects">
  <link name="box">
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.1" iyy="0.1" izz="0.1"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.25"/>
      <geometry><box size="0.5 0.5 0.5"/></geometry>
      <material name="green"><color rgba="0 1 0 1"/></material>
    </visual>
    <collision><origin xyz="0 0 0.25"/><geometry><box size="0.5 0.5 0.5"/></geometry></collision>
  </link>
</robot>
